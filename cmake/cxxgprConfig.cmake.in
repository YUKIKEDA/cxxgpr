# SPDX-License-Identifier: Apache-2.0
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Eigen3 5.0 CONFIG REQUIRED)
find_dependency(nlohmann_json 3.12 CONFIG REQUIRED)
if("@CXXGPR_ACTIVE_BLAS_BACKEND@" STREQUAL "OpenBLAS")
    find_dependency(OpenBLAS CONFIG REQUIRED)
elseif("@CXXGPR_ACTIVE_BLAS_BACKEND@" STREQUAL "MKL")
    if(NOT DEFINED MKL_ROOT AND DEFINED ENV{MKLROOT} AND NOT "$ENV{MKLROOT}" STREQUAL "")
        set(MKL_ROOT "$ENV{MKLROOT}")
    endif()
    if(UNIX AND NOT APPLE AND NOT DEFINED MKL_THREADING)
        set(MKL_THREADING "gnu_thread" CACHE STRING "MKL threading layer")
    endif()
    find_dependency(MKL CONFIG REQUIRED)
endif()
if(@CXXGPR_HAS_OPENMP@)
    find_dependency(OpenMP COMPONENTS CXX REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cxxgprTargets.cmake")

check_required_components(cxxgpr)
