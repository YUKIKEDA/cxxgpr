if(NOT DEFINED NOTICES_DIR OR NOT EXISTS "${NOTICES_DIR}")
    message(FATAL_ERROR "Missing third-party notices directory: '${NOTICES_DIR}'")
endif()

if(NOT DEFINED SHARE_DIR OR NOT EXISTS "${SHARE_DIR}")
    message(FATAL_ERROR "Missing vcpkg share directory: '${SHARE_DIR}'")
endif()

if(NOT DEFINED ROOT_NOTICE OR NOT EXISTS "${ROOT_NOTICE}")
    message(FATAL_ERROR "Missing THIRD_PARTY_NOTICES.md at '${ROOT_NOTICE}'")
endif()

set(_required eigen3 nlohmann-json openblas)
if(TOP_BUILD_TESTING)
    list(APPEND _required gtest)
endif()
if(TOP_BUILD_BENCHMARKS)
    list(APPEND _required benchmark)
endif()

foreach(_pkg IN LISTS _required)
    set(_orig_file "${SHARE_DIR}/${_pkg}/copyright")
    if(NOT EXISTS "${_orig_file}")
        message(FATAL_ERROR "Missing original copyright file: ${_orig_file}")
    endif()
    set(_notice_file "${NOTICES_DIR}/${_pkg}.txt")
    if(NOT EXISTS "${_notice_file}")
        message(FATAL_ERROR "Missing copied notice file: ${_notice_file}")
    endif()
    file(SIZE "${_notice_file}" _notice_bytes)
    if(_notice_bytes EQUAL 0)
        message(FATAL_ERROR "Empty notice file: ${_notice_file}")
    endif()
    file(SHA256 "${_orig_file}" _orig_sha256)
    file(SHA256 "${_notice_file}" _copy_sha256)
    if(NOT _orig_sha256 STREQUAL _copy_sha256)
        message(FATAL_ERROR
            "SHA-256 mismatch for notice '${_pkg}': original '${_orig_sha256}' != copied '${_copy_sha256}'")
    endif()
endforeach()

if(DEFINED FMATH_NOTICE_ORIG AND NOT "${FMATH_NOTICE_ORIG}" STREQUAL "")
    if(NOT EXISTS "${FMATH_NOTICE_ORIG}")
        message(FATAL_ERROR "Missing original fmath license notice: ${FMATH_NOTICE_ORIG}")
    endif()
    set(_fmath_copy "${NOTICES_DIR}/fmath.txt")
    if(NOT EXISTS "${_fmath_copy}")
        message(FATAL_ERROR "Missing copied fmath notice: ${_fmath_copy}")
    endif()
    file(SHA256 "${FMATH_NOTICE_ORIG}" _fmath_orig_sha)
    file(SHA256 "${_fmath_copy}" _fmath_copy_sha)
    if(NOT _fmath_orig_sha STREQUAL _fmath_copy_sha)
        message(FATAL_ERROR "SHA-256 mismatch for fmath notice")
    endif()
endif()

if(DEFINED MKL_NOTICE_ORIG AND NOT "${MKL_NOTICE_ORIG}" STREQUAL "")
    if(NOT EXISTS "${MKL_NOTICE_ORIG}")
        message(FATAL_ERROR "Missing original MKL license notice: ${MKL_NOTICE_ORIG}")
    endif()
    set(_mkl_copy "${NOTICES_DIR}/intel-mkl.txt")
    if(NOT EXISTS "${_mkl_copy}")
        message(FATAL_ERROR "Missing copied MKL notice: ${_mkl_copy}")
    endif()
    file(SHA256 "${MKL_NOTICE_ORIG}" _mkl_orig_sha)
    file(SHA256 "${_mkl_copy}" _mkl_copy_sha)
    if(NOT _mkl_orig_sha STREQUAL _mkl_copy_sha)
        message(FATAL_ERROR "SHA-256 mismatch for MKL notice")
    endif()
endif()

file(READ "${ROOT_NOTICE}" _root_text)
foreach(_keyword IN ITEMS "Eigen" "OpenBLAS" "Intel oneMKL" "fmath" "nlohmann" "GoogleTest" "Google Benchmark")
    string(FIND "${_root_text}" "${_keyword}" _pos)
    if(_pos EQUAL -1)
        message(FATAL_ERROR "THIRD_PARTY_NOTICES.md is missing entry for '${_keyword}'")
    endif()
endforeach()
