if(NOT DEFINED NOTICES_DIR OR NOT EXISTS "${NOTICES_DIR}")
    message(FATAL_ERROR "Missing third-party notices directory: '${NOTICES_DIR}'")
endif()

if(NOT DEFINED ROOT_NOTICE OR NOT EXISTS "${ROOT_NOTICE}")
    message(FATAL_ERROR "Missing THIRD_PARTY_NOTICES.md at '${ROOT_NOTICE}'")
endif()

set(_required eigen3 nlohmann-json)
if(TOP_BUILD_TESTING)
    list(APPEND _required gtest)
endif()
if(TOP_BUILD_BENCHMARKS)
    list(APPEND _required benchmark)
endif()

foreach(_pkg IN LISTS _required)
    set(_notice_file "${NOTICES_DIR}/${_pkg}.txt")
    if(NOT EXISTS "${_notice_file}")
        message(FATAL_ERROR "Missing copied notice file: ${_notice_file}")
    endif()
    file(SIZE "${_notice_file}" _notice_bytes)
    if(_notice_bytes EQUAL 0)
        message(FATAL_ERROR "Empty notice file: ${_notice_file}")
    endif()
endforeach()

file(READ "${ROOT_NOTICE}" _root_text)
foreach(_keyword IN ITEMS "Eigen" "nlohmann" "GoogleTest" "Google Benchmark")
    string(FIND "${_root_text}" "${_keyword}" _pos)
    if(_pos EQUAL -1)
        message(FATAL_ERROR "THIRD_PARTY_NOTICES.md is missing entry for '${_keyword}'")
    endif()
endforeach()
