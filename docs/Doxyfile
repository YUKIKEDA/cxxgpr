# Doxygen configuration for the public API of cxxgpr.
# The XML output is consumed by Sphinx through Breathe and by tools/qa/doc_api_coverage.py.
PROJECT_NAME           = cxxgpr
INPUT                  = include/cxxgpr
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
OUTPUT_DIRECTORY       = out/docs/doxygen
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "CXXGPR_API="
EXCLUDE_SYMBOLS         = cxxgpr::detail* cxxgpr::*::detail*
INPUT_FILTER           = "python tools/docs/doxygen_filter.py"
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
CPP_CLI_SUPPORT        = NO
MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
